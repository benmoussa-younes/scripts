<Project>
  <!--
    Repository-wide C# contract (Core naming pattern). Debian Linux /
    linux-x64 / net10.0 only. Invariant globalization is on because Debian ships
    no ICU. Every switch below (TreatWarningsAsErrors, InvariantGlobalization,
    IsAotCompatible, EnableTrimAnalyzer, PathMap, Deterministic…) applies to EVERY
    project of the solution; the real AOT switch, PublishAot, is set only on
    Scripts.App. No project opts
    out of the analyzer switches.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <!--
      Reproducibility: the absolute build path MUST NOT leak into the
      artifacts (AOT binary, .deb). Without this, two builds of the same commit in
      two directories produce different binaries (GCC build-id, rodata),
      and the SHA256SUMS written at a release is unverifiable by a third party.
      `ContinuousIntegrationBuild` normalizes the paths; `PathMap` replaces the
      repository directory with a stable prefix, wherever the clone lives.
    -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <!--
      Restore is locked by one packages.lock.json per project: the CI cache keys
      on the locks and a stale lock fails the build with NU1004 instead of
      silently resolving another version. The lock records the real graph,
      linux-x64 runtime packages included, so a locked AOT publish needs no
      special switch. After a PackageReference change, regenerate the locks with
      `dotnet restore Scripts.slnx -p:RestoreLockedMode=false
      -p:RestoreForceEvaluate=true`, then commit them with the change.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
</PropertyGroup>

  <!-- Release identity. The fallback is only for a build without git; the current surface is 0.1.0 and a release adds the tag. -->
  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <Authors>Younes BENMOUSSA</Authors>
    <Company>Scripts</Company>
    <Product>Scripts</Product>
    <Copyright>Copyright (C) 2026 Younes BENMOUSSA &lt;younes.benmoussa@pm.me&gt;</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
