function power(base: integer, exponent: integer) -> integer {
    let mutable result = 1
    let mutable i = 0
    while i < exponent {
        result *= base
        i += 1
    }
    return result
}
io.write_standard_output_line("p1={power(2, 10)}")
io.write_standard_output_line("p2={power(3, 3)}")
io.write_standard_output_line("p3={power(5, 0)}")
function early(flag: boolean) -> integer {
    if flag {
        return 1
    }
    return 2
}
io.write_standard_output_line("t={early(true)} f={early(false)}")
