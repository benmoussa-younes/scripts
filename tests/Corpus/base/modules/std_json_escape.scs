
# BLOCKER 1 (DESIGN 8.3/8.4): encode must escape exactly like the
# `result` field of `run --json-out` — raw UTF-8 for non-ASCII, lowercase \uXXXX
# for control characters, never the short forms.
let value = {
    "accent": "café",
    "quote": "a\"b",
    "backslash": "a\\b",
    "controls": "tab:\u{9} lf:\u{a} cr:\u{d} bs:\u{8} ff:\u{c} nul:\u{0} esc:\u{1b}",
    "del": "del:\u{7f}",
    "c1": "c1:\u{85}",
    "separators": "ls:\u{2028} ps:\u{2029}",
    "emoji": "😀🎉",
    "combining": "e\u{301}a\u{308}",
}
io.write_standard_output_line(json.encode(value)?)
io.write_standard_output_line(json.encode(value)?)
io.write_standard_output_line(json.encode("café")?)
io.write_standard_output_line(json.encode(["é", "😀", "\u{9}"])?)

# Key names use the same escaping as values.
io.write_standard_output_line(json.encode({"café": 1})?)
io.write_standard_output_line(json.encode({"\u{9}": 1})?)
