let values = [10, 20, 30, 40]
let mutable sum = 0
for v in values {
    sum += v
}
io.write_standard_output_line("sum={sum}")
for v in values {
    if v == 30 {
        break
    }
    io.write_standard_output_line("v={v}")
}
let mutable odds = 0
for v in values {
    if v % 20 == 0 {
        continue
    }
    odds += v
}
io.write_standard_output_line("odds={odds}")
