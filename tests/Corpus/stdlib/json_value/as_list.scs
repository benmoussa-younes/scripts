
let document = json.decode("[\"admin\", \"dev\"]")?
let roles = document.as_list()?
io.write_standard_output_line("{roles.length()}")
io.write_standard_output_line(roles[0].as_string().value_or("?"))

match json.decode("1")?.as_list() {
    ok(items) => io.write_standard_output_line("{items.length()}")
    error(failure) => io.write_standard_output_line(failure.kind)
}

let empty = json.decode("[]")?.as_list()?
io.write_standard_output_line("{empty.length()}")
