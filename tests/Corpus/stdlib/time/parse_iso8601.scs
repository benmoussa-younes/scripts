io.write_standard_output_line("{time.parse_iso8601("1970-01-01T00:00:00Z")?}")
io.write_standard_output_line("{time.parse_iso8601("1970-01-01T01:00:00+01:00")?}")
let plus_fourteen = time.parse_iso8601("1970-01-01T14:00:00+14:00")?
let minus_fourteen = time.parse_iso8601("1970-01-01T00:00:00-14:00")?
io.write_standard_output_line("{plus_fourteen == time.parse_iso8601("1970-01-01T00:00:00Z")?}")
io.write_standard_output_line("{minus_fourteen == time.parse_iso8601("1970-01-01T14:00:00Z")?}")
match time.parse_iso8601("1970-01-01 00:00:00") {
    ok(seconds) => io.write_standard_output_line("{seconds}")
    error(failure) => io.write_standard_output_line("{failure.kind}: {failure.message}")
}
match time.parse_iso8601("1970-01-01T00:00:00+14:01") {
    ok(seconds) => io.write_standard_output_line("{seconds}")
    error(failure) => io.write_standard_output_line("{failure.kind}: {failure.message}")
}
match time.parse_iso8601("1970-01-01T00:00:00-14:01") {
    ok(seconds) => io.write_standard_output_line("{seconds}")
    error(failure) => io.write_standard_output_line("{failure.kind}: {failure.message}")
}
match time.parse_iso8601("1970-01-01T00:00:00+23:00") {
    ok(seconds) => io.write_standard_output_line("{seconds}")
    error(failure) => io.write_standard_output_line("{failure.kind}: {failure.message}")
}
match time.parse_iso8601("1970-01-01T00:00:00-23:59") {
    ok(seconds) => io.write_standard_output_line("{seconds}")
    error(failure) => io.write_standard_output_line("{failure.kind}: {failure.message}")
}
