match "abcdef".substring(1, 3) {
    ok(part) => io.write_standard_output_line("[{part}]")
    error(e) => io.write_standard_output_line(e.kind)
}
match "abc".substring(0, 9) {
    ok(part) => io.write_standard_output_line("[{part}]")
    error(e) => io.write_standard_output_line(e.kind)
}
match "abc".substring(-1, 2) {
    ok(part) => io.write_standard_output_line("[{part}]")
    error(e) => io.write_standard_output_line(e.kind)
}
