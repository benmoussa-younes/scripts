let root_directory = filesystem.make_temporary_directory("scripts-realpath-")?
let target_path = root_directory / "a.txt"
filesystem.write_file_overwrite("", target_path)?
let resolved = filesystem.get_real_path(target_path)?
io.write_standard_output_line("{resolved.is_absolute()} {resolved.base_name()}")
match filesystem.get_real_path(root_directory / "absent") {
    ok(_) => io.write_standard_output_line("found")
    error(failure) => io.write_standard_output_line(failure.kind)
}
filesystem.remove_directory_tree(root_directory)?
