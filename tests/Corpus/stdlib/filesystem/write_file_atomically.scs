let work_directory = filesystem.make_temporary_directory("scripts-stdlib-")?
let file_path = work_directory / "note.txt"
filesystem.write_file_overwrite("ancien", file_path)?
filesystem.write_file_overwrite_atomically("nouveau", file_path)?
io.write_standard_output_line(filesystem.read_file(file_path)?)
# The scratch file is gone: the directory holds only the destination.
let entries = filesystem.list_directory(work_directory)?
io.write_standard_output_line("{entries.length()}")
match filesystem.write_file_overwrite_atomically("x", work_directory) {
    ok(_) => io.write_standard_output_line("written")
    error(failure) => io.write_standard_output_line(failure.kind)
}
match filesystem.write_file_overwrite_atomically("x", work_directory / "absent" / "f.txt") {
    ok(_) => io.write_standard_output_line("written")
    error(failure) => io.write_standard_output_line(failure.kind)
}
filesystem.remove_directory_tree(work_directory)?
