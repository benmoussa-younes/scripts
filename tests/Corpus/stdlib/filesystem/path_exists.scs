io.write_standard_output_line("{filesystem.path_exists(p"/")}")
io.write_standard_output_line("{filesystem.path_exists(p"/scripts-spec-inexistant")}")
let work_directory = filesystem.make_temporary_directory("scripts-stdlib-")?
io.write_standard_output_line("{filesystem.path_exists(work_directory)}")
filesystem.remove_directory_tree(work_directory)?
io.write_standard_output_line("{filesystem.path_exists(work_directory)}")
io.write_standard_output_line("{filesystem.path_exists(p"")}")
