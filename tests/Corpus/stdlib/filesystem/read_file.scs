match filesystem.read_file(p"/scripts-spec-inexistant/absent.txt") {
    ok(content) => io.write_standard_output_line(content)
    error(failure) => io.write_standard_output_line(failure.kind)
}
let work_directory = filesystem.make_temporary_directory("scripts-stdlib-")?
filesystem.write_file_overwrite("bonjour", work_directory / "note.txt")?
io.write_standard_output_line(filesystem.read_file(work_directory / "note.txt")?)
match filesystem.read_file(work_directory) {
    ok(content) => io.write_standard_output_line(content)
    error(failure) => io.write_standard_output_line(failure.kind)
}
filesystem.remove_directory_tree(work_directory)?
