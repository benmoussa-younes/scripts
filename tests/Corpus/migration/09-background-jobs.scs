#!/usr/bin/scripts run
# scripts → Pattern 09: background jobs (&, wait, $!)
let mutable running_jobs: list<process_handle> = []
for job_number in range(1, 4) {
    let handle = process.spawn("printf", ["job {job_number}\n"])?
    running_jobs.append(handle)
}
for running_job in running_jobs {
    let finished = process.wait_for_process(running_job, 0)?
    io.write_standard_output_line("{finished.standard_output.trim_whitespace()} termine, code {finished.exit_code}")
}

let failing_job = process.spawn("false", [])?
let failing_outcome = process.wait_for_process(failing_job, 0)?
io.write_standard_output_line("job en echec: code {failing_outcome.exit_code}")
