#!/usr/bin/scripts run
# scripts → Pattern 15: guaranteed cleanup (trap ... EXIT)

function do_work(work_directory: path) -> result<unit, string> {
    let work_file = work_directory / "work.txt"
    filesystem.write_file_overwrite("donnees\n", work_file).transform_error(write_failure => write_failure.message)?
    let stored_text = filesystem.read_file(work_file).transform_error(read_failure => read_failure.message)?
    io.write_standard_output_line("travail: {stored_text.trim_whitespace()}")
    let step = process.run(process.request("false", [])).transform_error(spawn_failure => spawn_failure.message)?
    if step.exit_code != 0 {
        return error("etape en echec")
    }
    io.write_standard_output_line("jamais affiche")
    return ok()
}

let temporary_directory = filesystem.make_temporary_directory("scripts-migration-15")?
let work_outcome = do_work(temporary_directory)
match work_outcome {
    ok(_) => io.write_standard_output_line("travail termine")
    error(work_reason) => io.write_standard_output_line("echec: {work_reason}")
}
filesystem.remove_directory_tree(temporary_directory)?
io.write_standard_output_line("nettoyage termine")
