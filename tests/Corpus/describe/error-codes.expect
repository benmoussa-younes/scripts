check: next(e for e in doc["error_codes"] if e["code"] == "SCRIPTS-CLI-0006")["category"] == "cli"
check: all(isinstance(e["message"], str) and e["message"] != "" for e in doc["error_codes"])
check: all(isinstance(e["position"], str) and e["position"] != "" for e in doc["error_codes"])
