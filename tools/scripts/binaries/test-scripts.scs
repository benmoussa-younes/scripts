#!/usr/bin/env -S scripts run
# Regression test for tools/scripts/binaries/version.sh.
# Run from anywhere: scripts run tools/scripts/binaries/test-scripts.scs
#
# The version comes from git when it is available and from the 0.1.0 fallback
# otherwise; the exact tag mapping is pinned on a synthetic tag.
let repo = process.script_path().parent().parent().parent().parent()

function run_version(repo: path, search_path: string) -> process_result {
    let request = process.request("tools/scripts/binaries/version.sh", [])
        .with_working_directory(repo)
        .with_environment({"PATH": search_path})
    return match process.run(request) {
        ok(outcome) => outcome
        error(failure) => process.exit_with_message(251, "test-scripts: {failure.message}")
    }
}

function fail(root: path, label: string, detail: string) -> unit {
    io.write_standard_error_line("test-scripts: FAIL {label}: {detail}")
    match filesystem.remove_directory_tree(root) {
        ok(_) => {}
        error(_) => {}
    }
    process.exit_with_code(1)
}

function git_run(repo: path, arguments: list<string>) -> process_result {
    let request = process.request("git", arguments).with_working_directory(repo)
    return match process.run(request) {
        ok(outcome) => outcome
        error(failure) => process.exit_with_message(251, "test-scripts: {failure.message}")
    }
}

function is_release_version(full_text: string) -> boolean {
    let base = full_text.split("+")[0].replace("_dirty", "")
    let parts = base.split(".")
    if parts.length() != 3 {
        return false
    }
    for part in parts {
        if part.parse_integer().value_or(-1) < 0 {
            return false
        }
    }
    return true
}

function expect_exit(label: string, outcome: process_result, expected: integer, root: path) -> unit {
    if outcome.exit_code != expected {
        io.write_standard_error_line("test-scripts: FAIL {label}: expected exit {expected}, got {outcome.exit_code}")
        io.write_standard_error_line(outcome.standard_error.trim_whitespace())
        match filesystem.remove_directory_tree(root) {
            ok(_) => {}
            error(_) => {}
        }
        process.exit_with_code(1)
    }
    io.write_standard_output_line("ok   {label}")
}

let root = filesystem.make_temporary_directory("scripts-script-tests-")?

# 1. git available: the computed version has the release shape. The exact tag
#    mapping is case 3, so a future release line cannot break this test.
let computed = run_version(repo, "/usr/local/bin:/usr/bin:/bin")
if computed.exit_code != 0 {
    fail(root, "version git", "exit {computed.exit_code}: {computed.standard_error.trim_whitespace()}")
}
let computed_text = computed.standard_output.trim_whitespace()
if not is_release_version(computed_text) {
    fail(root, "version git", "expected X.Y.Z, got '{computed_text}'")
}
io.write_standard_output_line("ok   version git is {computed_text}")

# 2. git unavailable: PATH holds only the programs version.sh needs before it
#    looks for git, and the fallback is exactly 0.1.0.
let bin = root / "bin"
filesystem.make_directory(bin)?
filesystem.copy_file(source_path = "/bin/sh".to_path(), destination_path = bin / "sh")?
filesystem.copy_file(source_path = "/usr/bin/dirname".to_path(), destination_path = bin / "dirname")?
let fallback = run_version(repo, bin.to_string())
if fallback.exit_code != 0 {
    fail(root, "version fallback", "exit {fallback.exit_code}: {fallback.standard_error.trim_whitespace()}")
}
let fallback_text = fallback.standard_output.trim_whitespace()
if fallback_text != "0.1.0" {
    fail(root, "version fallback", "expected '0.1.0', got '{fallback_text}'")
}
io.write_standard_output_line("ok   version fallback is 0.1.0")

# 3. Dirty detection (the loop replaced awk): a modified tracked file marks the
#    version, a modified packaging/SHA256SUMS (regenerated by every build) does not.
let version_repo = root / "version-repo"
filesystem.make_directory_tree(version_repo / "tools/scripts/binaries")?
filesystem.copy_file(source_path = repo / "tools/scripts/binaries/version.sh", destination_path = version_repo / "tools/scripts/binaries/version.sh")?
filesystem.write_file_overwrite("one\n", version_repo / "README.md")?
expect_exit("version repo init", git_run(version_repo, ["init", "-q", "-b", "main"]), 0, root)
expect_exit("version repo add", git_run(version_repo, ["add", "README.md"]), 0, root)
expect_exit("version repo commit", git_run(version_repo, [
    "-c", "user.name=Test", "-c", "user.email=test@example.com",
    "-c", "commit.gpgsign=false",
    "commit", "-q", "-m", "init",
]), 0, root)
expect_exit("version repo tag", git_run(version_repo, ["-c", "tag.gpgsign=false", "tag", "v9.8.7"]), 0, root)

let clean_version = run_version(version_repo, "/usr/local/bin:/usr/bin:/bin")
if clean_version.exit_code != 0 {
    fail(root, "version clean", "exit {clean_version.exit_code}: {clean_version.standard_error.trim_whitespace()}")
}
let clean_text = clean_version.standard_output.trim_whitespace()
if clean_text != "9.8.7" {
    fail(root, "version clean", "expected '9.8.7', got '{clean_text}'")
}

filesystem.write_file_overwrite("two\n", version_repo / "README.md")?
let dirty_version = run_version(version_repo, "/usr/local/bin:/usr/bin:/bin")
let dirty_text = dirty_version.standard_output.trim_whitespace()
if dirty_text != "9.8.7_dirty" {
    fail(root, "version dirty", "expected '9.8.7_dirty', got '{dirty_text}'")
}
expect_exit("version repo restore", git_run(version_repo, ["checkout", "--", "README.md"]), 0, root)

filesystem.make_directory(version_repo / "packaging")?
filesystem.write_file_overwrite("sums\n", version_repo / "packaging/SHA256SUMS")?
expect_exit("version repo add sums", git_run(version_repo, ["add", "packaging/SHA256SUMS"]), 0, root)
expect_exit("version repo commit sums", git_run(version_repo, [
    "-c", "user.name=Test", "-c", "user.email=test@example.com",
    "-c", "commit.gpgsign=false",
    "commit", "-q", "-m", "sums",
]), 0, root)
filesystem.write_file_overwrite("changed\n", version_repo / "packaging/SHA256SUMS")?
let artifact_version = run_version(version_repo, "/usr/local/bin:/usr/bin:/bin")
let artifact_text = artifact_version.standard_output.trim_whitespace()
if artifact_text.contains("_dirty") {
    fail(root, "version artifact", "packaging/SHA256SUMS must be ignored: {artifact_text}")
}
if not artifact_text.starts_with("9.8.7+1.") {
    fail(root, "version ahead", "expected '9.8.7+1.<hash>', got '{artifact_text}'")
}
io.write_standard_output_line("ok   version dirty detection (tracked file, artifact excluded)")

filesystem.remove_directory_tree(root)?
io.write_standard_output_line("test-scripts: PASS")
