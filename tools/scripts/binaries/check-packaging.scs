#!/usr/bin/env -S scripts run
# Checks that the release metadata names one version before the tag is cut.
# Run from anywhere: scripts run tools/scripts/binaries/check-packaging.scs
#
# Reads packaging/debian/{changelog,control}, CHANGELOG.md, README.md,
# packaging/verify-release.sh and .github/workflows/release.yml; the tag check
# runs only when HEAD is exactly a tag. The workflow and checker checks are form
# only: the gate cannot run a release.
import "../modules/versions.scs" as versions

let root = process.script_path().parent().parent().parent().parent()

function read_text(root: path, relative: string) -> string {
    return match filesystem.read_file(root / relative) {
        ok(text) => text
        error(failure) => process.exit_with_message(1, "check-packaging: {relative}: {failure.kind}")
    }
}

function first_line(text: string) -> string {
    return text.split("\n")[0].trim_whitespace()
}

function between(text: string, opening: string, closing: string) -> string {
    let parts = text.split(opening)
    if parts.length() < 2 {
        return ""
    }
    return parts[1].split(closing)[0]
}

function commands_outside_comments(text: string) -> list<string> {
    let mutable kept: list<string> = []
    for line in text.split("\n") {
        let trimmed = line.trim_whitespace()
        if trimmed != "" and not trimmed.starts_with("#") {
            kept.append(trimmed)
        }
    }
    return kept
}

function any_line_starts_with(lines: list<string>, prefix: string) -> boolean {
    let mutable found = false
    for line in lines {
        if line.starts_with(prefix) {
            found = true
        }
    }
    return found
}

function any_line_contains(lines: list<string>, marker: string) -> boolean {
    let mutable found = false
    for line in lines {
        if line.contains(marker) {
            found = true
        }
    }
    return found
}

function exact_tag(root: path) -> string {
    let request = process.request("git", ["describe", "--exact-match", "--tags", "HEAD"]).with_working_directory(root)
    return match process.run(request) {
        ok(outcome) => {
            if outcome.exit_code != 0 {
                return ""
            }
            return outcome.standard_output.trim_whitespace()
        }
        error(_) => ""
    }
}

let mutable failures: list<string> = []
let changelog = read_text(root, "packaging/debian/changelog")
let control = read_text(root, "packaging/debian/control")
let changelog_markdown = read_text(root, "CHANGELOG.md")
let readme = read_text(root, "README.md")

let version = between(first_line(changelog), "(", ")")
if not versions.is_release_version(version) {
    failures.append("packaging/debian/changelog: first line carries '{version}', expected X.Y.Z")
}

let mutable control_version = ""
let mutable control_fields = 0
for line in control.split("\n") {
    if line.starts_with("Version:") {
        control_fields = control_fields + 1
        control_version = line.split(":")[1].trim_whitespace()
    }
}
if control_fields != 1 {
    failures.append("packaging/debian/control: {control_fields} Version lines, expected exactly one")
}
if control_version != version {
    failures.append("packaging/debian/control: Version '{control_version}' != changelog '{version}'")
}

let mutable announced = ""
for line in changelog_markdown.split("\n") {
    let trimmed = line.trim_whitespace()
    if announced == "" and trimmed.starts_with("## [") and not trimmed.starts_with("## [Unreleased]") {
        announced = between(trimmed, "[", "]")
    }
}
if announced != version {
    failures.append("CHANGELOG.md: top release '{announced}' != changelog '{version}'")
}

if not readme.contains("sudo apt install ./scripts_{version}_amd64.deb") {
    failures.append("README.md: no 'sudo apt install ./scripts_{version}_amd64.deb'")
}
if not readme.contains("tar -xzf scripts_{version}_linux-x64.tar.gz") {
    failures.append("README.md: no 'tar -xzf scripts_{version}_linux-x64.tar.gz'")
}
if not readme.contains("sudo install -m 755 scripts-{version}/scripts /usr/local/bin/scripts") {
    failures.append("README.md: no install line for scripts-{version}/scripts")
}
if not readme.contains("Scripts {version} is the current release") {
    failures.append("README.md: no 'Scripts {version} is the current release'")
}

let release_workflow = read_text(root, ".github/workflows/release.yml")
let release_checker = read_text(root, "packaging/verify-release.sh")
let workflow_commands = commands_outside_comments(release_workflow)
let checker_commands = commands_outside_comments(release_checker)

if not any_line_starts_with(workflow_commands, "gpg --batch --import packaging/maintainer-key.asc") {
    failures.append(".github/workflows/release.yml: has no 'gpg --batch --import packaging/maintainer-key.asc' line")
}
if not any_line_starts_with(workflow_commands, "bash packaging/verify-release.sh --require-tag") {
    failures.append(".github/workflows/release.yml: has no 'bash packaging/verify-release.sh --require-tag' line")
}
if not any_line_starts_with(workflow_commands, "uses: actions/attest-build-provenance@") {
    failures.append(".github/workflows/release.yml: has no 'uses: actions/attest-build-provenance@' line")
}
if not release_workflow.contains("\n  release:\n    needs: build\n") {
    failures.append(".github/workflows/release.yml: the release job does not declare 'needs: build'")
}
if not any_line_starts_with(workflow_commands, "subject-path: artifacts/*") {
    failures.append(".github/workflows/release.yml: the attestation has no 'subject-path: artifacts/*'")
}
if not any_line_starts_with(workflow_commands, "path: artifacts") {
    failures.append(".github/workflows/release.yml: no 'path: artifacts' hand-off between build and release")
}
for marker in ["SHA256SUMS.asc", "tarballs.sha256.asc", "packaging/*.asc"] {
    if any_line_contains(workflow_commands, marker) {
        failures.append(".github/workflows/release.yml: references {marker}, but no release publishes a signature")
    }
    if any_line_contains(checker_commands, marker) {
        failures.append("packaging/verify-release.sh: references {marker}, but no release publishes a signature")
    }
}
if not readme.contains("git verify-tag") {
    failures.append("README.md: no 'git verify-tag' command")
}
if not readme.contains("gh attestation verify") {
    failures.append("README.md: no 'gh attestation verify' command")
}

let lines = changelog.split("\n")
for index in range(0, lines.length()) {
    if lines[index].length() > 80 {
        failures.append("packaging/debian/changelog:{index + 1}: {lines[index].length()} characters, Debian allows 80")
    }
}

let tag = exact_tag(root)
if tag != "" and tag != "v{version}" {
    failures.append("git: HEAD is tagged '{tag}', the metadata names '{version}'")
}

if failures.length() > 0 {
    for failure in failures {
        io.write_standard_error_line("check-packaging: {failure}")
    }
    io.write_standard_error_line("packaging: FAIL ({failures.length()} finding(s))")
    process.exit_with_code(1)
}
io.write_standard_output_line("packaging: PASS ({version})")
process.exit_with_code(0)
