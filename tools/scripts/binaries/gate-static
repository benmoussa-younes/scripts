#!/usr/bin/env bash
# gate-static — the compile-and-test gate used by a worker job.
#
#   tools/scripts/binaries/gate-static
# It builds, runs the fast Native AOT suites (Syntax, Checker, Cli), and checks
# tree hygiene: no legacy name, no tracked samples/editor directory, no
# whitespace error. No corpus, no E2E, no licence copy. It does not change
# tracked files.
set -u
export LC_ALL=C

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd "${script_directory}/../../.." && pwd)"
cd "${repository_root}" || exit 1

failure=0
step() {
    local label="$1"
    shift
    if "$@"; then
        echo "PASS ${label}"
    else
        echo "FAIL ${label}"
        failure=1
    fi
}

step "build" dotnet build Scripts.slnx -c Release

if [ "${failure}" -eq 0 ]; then
    step "tests (Native AOT)" bash tools/scripts/binaries/aot-tests.sh --fast
fi

if [ "${failure}" -eq 0 ]; then
    if git grep -n -E 'BCS-[0-9]|BitCrafts|\.bcs\b|\bbcs\b|Shell\.' -- src tests packaging; then
        echo "FAIL no legacy name"
        failure=1
    else
        echo "PASS no legacy name"
    fi
fi

if [ "${failure}" -eq 0 ]; then
    if [ -n "$(git ls-files -- samples .opencode .vscode)" ]; then
        echo "FAIL no tracked samples/editor directory"
        failure=1
    else
        echo "PASS no tracked samples/editor directory"
    fi
fi

if [ "${failure}" -eq 0 ]; then
    if git diff --check; then
        echo "PASS no whitespace error"
    else
        echo "FAIL no whitespace error"
        failure=1
    fi
fi

if [ "${failure}" -eq 0 ]; then
    echo "VERDICT: PASS"
    exit 0
fi

echo "VERDICT: FAIL"
exit 1
