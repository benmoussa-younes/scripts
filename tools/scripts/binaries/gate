#!/usr/bin/env bash
# gate — read-only full verification of this repository.
#
#   tools/scripts/binaries/gate [--no-build]
# It runs check-all.sh (7 steps with the build, 6 with --no-build; tests run
# only as Native AOT executables), streams its output, and ends with exactly
# one VERDICT line. It does not change tracked files.
set -u
export LC_ALL=C

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

bash "${script_directory}/check-all.sh" "$@"
status=$?
if [ "${status}" -eq 0 ]; then
    echo "VERDICT: PASS"
    exit 0
fi

echo "VERDICT: FAIL"
exit 1
